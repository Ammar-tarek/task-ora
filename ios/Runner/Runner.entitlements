<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS Universal Links: the app claims the shared attendance domain so
	     tapping https://operations.cashback.marketing/checkin opens the app.
	     Requires https://operations.cashback.marketing/.well-known/apple-app-site-association
	     to list this app's <TeamID>.com.example.taskOra appID.
	     Add this file to the Runner target in Xcode (Signing & Capabilities →
	     Associated Domains) and replace the host for a custom domain. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:operations.cashback.marketing</string>
	</array>
</dict>
</plist>
